# ==============================================================================
# Variáveis de ambiente para desenvolvimento local (Docker Compose)
# Bolão da Copa do Mundo Feminina da FIFA Brasil 2027™
# ==============================================================================

# --- Frontend (Next.js) ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (FastAPI / Python) ---
PYTHONPATH=/app
ENVIRONMENT=development
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
# Chave de segurança para tokens/sessões locais (substituir em produção)
SECRET_KEY=development-secret-key-change-in-production-only-min-32-chars
# Expiração do token de recuperação de senha (entre 30 e 60 minutos conforme regra)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Banco de Dados (PostgreSQL) ---
POSTGRES_DB=bolao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Driver psycopg 3 síncrono (ADR-001): esquema postgresql+psycopg://. No Compose, o backend recebe
# esta URL montada a partir de POSTGRES_* (use senha sem caracteres especiais de URL). Este valor
# serve para executar o backend/Alembic fora do Compose (troque o host por localhost).
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/bolao

# --- Fuso Horário Padronizado ---
TZ=America/Sao_Paulo
